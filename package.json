        "briefcase": "./assets/icons/briefcase.svg",
        "camera": "./assets/icons/camera.svg",
        "chart-line": "./assets/icons/chart-line.svg",
        "coins": "./assets/icons/coins.svg",
        "compass": "./assets/icons/compass.svg",
        "crown": "./assets/icons/crown.svg",
        "diamond": "./assets/icons/diamond.svg",
        "fire": "./assets/icons/fire.svg",
        "flag": "./assets/icons/flag.svg",
        "gamepad": "./assets/icons/gamepad.svg",
        "heart": "./assets/icons/heart.svg",
        "idea": "./assets/icons/idea.svg",
        "map": "./assets/icons/map.svg",
        "mountain": "./assets/icons/mountain.svg",
        "music": "./assets/icons/music.svg",
